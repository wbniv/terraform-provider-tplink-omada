+func writeExpiryResponse(w http.ResponseWriter, redirect bool) {
+	if redirect {
+		w.Header().Set("Location", "/controller/login")
+		w.WriteHeader(http.StatusFound)
+		return
+	}
+	fmt.Fprint(w, `{"errorCode":-1,"msg":"expired"}`)
+}
